# Copy this file to ".env" and fill in your values.
#
# No Anthropic API key is needed — this bot uses your local Claude Code login
# (your subscription). Just make sure `claude` is installed and logged in.

# From Telegram's @BotFather (send /newbot, follow the steps).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave blank at first; send /start to the bot to learn your ID, then set it here.
ALLOWED_USER_IDS=

# Optional overrides
# CAREER_AGENT_MODEL=claude-opus-4-8   # or claude-sonnet-4-5 to use fewer credits
# CLAUDE_BIN=~/.local/bin/claude

# --- AI backend (which "brain" answers) ------------------------------------
# Default is the Claude subscription via the `claude` CLI. To run on OpenCode
# instead (any model/provider you configure), uncomment AI_BACKEND below.
# Full setup guide: docs/opencode-setup.md
# AI_BACKEND=opencode
# OPENCODE_MODEL=openrouter/anthropic/claude-sonnet-4.5   # provider/model form
# OPENCODE_BIN=/path/to/opencode                          # only if not on PATH
#
# For the env-var auth route (simplest in Docker), also set your provider key,
# e.g.:
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=     # NOTE: pay-as-you-go API, NOT your subscription
