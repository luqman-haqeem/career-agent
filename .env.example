# Copy this file to ".env" and fill in your values.
#
# This bot runs on the OpenCode CLI pointed at OpenRouter (per-token billing).

# From Telegram's @BotFather (send /newbot, follow the steps).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave blank at first; send /start to the bot to learn your ID, then set it here.
ALLOWED_USER_IDS=

# --- OpenCode / OpenRouter -------------------------------------------------
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Model in OpenCode's provider/model form. Defaults to gemini-2.5-flash-lite on
# OpenRouter (cheap, clean output). Swap to a different model to suit your needs.
# Avoid "thinking"-variant models — they leak chain-of-thought into replies.
# OPENCODE_MODEL=openrouter/google/gemini-2.5-flash-lite
# OPENCODE_BIN=/path/to/opencode   # only if not on PATH

# --- Job discovery (optional overrides) ------------------------------------
# SCAN_HOUR=9
# SCAN_TZ=Asia/Kuala_Lumpur
# SCAN_WEEKDAYS=0,3
